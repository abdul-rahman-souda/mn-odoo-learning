<!-- <?xml version="1.0" encoding="utf-8"?> -->
<odoo>
    <record id="property_view_list" model="ir.ui.view">
        <field name="name">property list</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <!-- <list multi_edit="1" create="1" edit="1" delete="1"> -->
            <list class='header_custom'>
                <field name="name" />
                <field name="postcode" />
                <field name="owner_id" />
                <field name="date_availablity" />
                <field name="selling_price" />
                <field name="garden" />
                <field name="facades" />
                <field name="state" />
                <field name="garden_area" />
                <field name="bedrooms" optional="1"/>
                <field name="garage" optional="1"/>
            </list>
        </field>
    </record>

    <record id="property_view_form" model="ir.ui.view">
        <field name="name">property form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <form create="1" edit="1" delete="1">
                <sheet>
                    <header>
                        <button name="action_draft" type="object" class="btn-primary" string="Set To Draft"
                        invisible="state == 'draft'"/>
                        <button name="action_pending" type="object" class="btn-secondary" string="Set To Pending"
                        invisible="state != 'draft'"/>
                        <button name="action_sold" type="object" class="btn-success" string="Set To sold"
                        invisible="state != 'pending'"/>
                        <!-- <field name="state" widget="statusbar" statusbar_visible="draft,pending,sold" options="{'clickable':1}"/> -->
                        <field name="state" widget="statusbar" statusbar_visible="draft,pending,sold" options="{}"/>
                    </header>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field  name="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="General Info.">
                            <field name="date_availablity" required="1"/>
                            <field name="postcode" />
                            <field name="expected_price" />
                            <field name="selling_price" />
                            <field name="diff" />
                            <field name="bedrooms" />
                            <field name="living_area" />
                            <field name="facades" />
                        </group>
                        <group string="Additional Info.">
                            <field name="owner_id" />
                            <field name="owner_address" />
                            <field name="owner_phone" />
                            <field name="owner_phone_number" />
                            <field name="garden" />
                            <field name="garden_area"/>
                            <field name="garden_orientation"/>
                            <field name="garage"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" required="1"/>
                    </group>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
                <chatter/>
            </form>
        </field>
    </record>

    <record id="property_view_search" model="ir.ui.view">
        <field name="name">property search</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="postcode"/>

                <filter name="is_garden" string="With Garden" domain="[('garden','=',True)]"/>
                <filter name="is_not_garden" string="Without Garden" domain="[('garden','=',False)]"/>
                <filter name="is_garage" string="With Garage" domain="[('garage','=',True)]"/>


                <filter name="group_garden" string="Garden" context="{'group_by':'garden'}"/>
            </search>
        </field>
    </record>

    <record id="property_action" model="ir.actions.act_window">
        <field name="name">Property</field>
        <field name="res_model">property</field>
    </record>

    <menuitem
        id="property_menu_item"
        name="Properties"
        parent="property_root_menu"
        action="property_action"
    />
</odoo>