<!-- <?xml version="1.0" encoding="utf-8"?> -->
<odoo>
    <record id="tag_view_list" model="ir.ui.view">
        <field name="name">tag list</field>
        <field name="model">tag</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="name" />

            </list>
        </field>
    </record>

    <record id="tag_view_form" model="ir.ui.view">
        <field name="name">tag form</field>
        <field name="model">tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field  name="name" />
                        </h1>
                    </div>
                    <group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="tag_action" model="ir.actions.act_window">
        <field name="name">Tag</field>
        <field name="res_model">tag</field>
    </record>

    <menuitem
        id="tag_menu_item"
        name="Tags"
        parent="configuration_root_menu"
        action="tag_action"
    />
</odoo>